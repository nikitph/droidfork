<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.droidfork.observer">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="DroidFork benchmark observer">
        <service android:name=".Observer" android:exported="true"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/access"/>
        </service>
    </application>
</manifest>
