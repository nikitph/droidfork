+// Rebind the main RAM region while the snapshot loader has all vCPUs stopped.
+// QEMU devices keep their HVA pointers. HVF gets the new private VM object
+// explicitly, including any RAM slots split by the machine memory layout.
+bool droidfork_hvf_map_private(void *host, size_t bytes, int fd) {
+    uintptr_t first = (uintptr_t)host;
+    uintptr_t end = first + bytes;
+    bool remap[HVF_MAX_SLOTS] = { false };
+    pthread_rwlock_wrlock(&mem_lock);
+    for (int i = 0; i < HVF_MAX_SLOTS; ++i) {
+        struct mac_slot *s = &mac_slots[i];
+        uintptr_t addr = (uintptr_t)s->hva;
+        if (!s->present || addr >= end || addr + s->size <= first) continue;
+        if (addr < first || addr + s->size > end || s->modified_mapping) {
+            pthread_rwlock_unlock(&mem_lock);
+            return false;
+        }
+        remap[i] = true;
+    }
+    for (int i = 0; i < HVF_MAX_SLOTS; ++i)
+        if (remap[i]) assert_hvf_ok(hv_vm_unmap(mac_slots[i].gpa_start, mac_slots[i].size));
+    void *result = mmap(host, bytes, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_FIXED, fd, 16384);
+    for (int i = 0; i < HVF_MAX_SLOTS; ++i)
+        if (remap[i]) assert_hvf_ok(hv_vm_map(mac_slots[i].hva, mac_slots[i].gpa_start,
+                mac_slots[i].size, mac_slots[i].flags));
+    pthread_rwlock_unlock(&mem_lock);
+    return result == host;
+}
